# Neon PostgreSQL connection string. Use the *pooled* endpoint (host contains
# "-pooler") for the app on Vercel. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooled) URL used only by `pnpm db:migrate`.
# Falls back to DATABASE_URL when unset.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Timezone used for "issued today" totals and for displaying timestamps.
NEXT_PUBLIC_EVENT_TIMEZONE="Asia/Kolkata"

# First admin account, created/updated by `pnpm db:seed` and `pnpm user:create`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
ADMIN_NAME="Event Admin"

# Integration tests run against a real PostgreSQL database. This database is
# wiped by the test suite, so never point it at production.
TEST_DATABASE_URL="postgresql://localhost:5432/food_management_test"
